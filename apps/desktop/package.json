{
  "name": "@creare/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Creare — agentic DevOps platform for AI-native software teams",
  "author": "Bruna Goncalves Vasconcelos",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node ../../scripts/rebuild-better-sqlite3.mjs ensure electron && node ../../scripts/install-desktop-entry.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -b --noEmit",
    "prepreview": "node ../../scripts/rebuild-better-sqlite3.mjs ensure electron",
    "preview": "electron-vite preview",
    "pretest": "node ../../scripts/rebuild-better-sqlite3.mjs ensure node",
    "test": "vitest run",
    "pree2e": "node ../../scripts/rebuild-better-sqlite3.mjs ensure electron",
    "e2e": "electron-vite build && playwright test",
    "lint": "eslint src",
    "package": "electron-vite build && electron-builder",
    "package:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@creare/agent-orchestration": "workspace:*",
    "@creare/ai-sdk": "workspace:*",
    "@creare/boards": "workspace:*",
    "@creare/database": "workspace:*",
    "@creare/eval": "workspace:*",
    "@creare/integrations": "workspace:*",
    "@creare/memory": "workspace:*",
    "@creare/observability": "workspace:*",
    "@creare/reporting": "workspace:*",
    "@creare/shared": "workspace:*",
    "@creare/tool-registry": "workspace:*",
    "@fastify/cors": "^9.0.0",
    "better-sqlite3": "^12.10.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@tanstack/react-query": "^5.28.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.1.0",
    "fastify": "^4.26.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.358.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.22.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.0",
    "@testing-library/react": "^15.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "electron-vite": "^2.1.0",
    "playwright": "^1.43.0",
    "postcss": "^8.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.4.0"
  }
}
