{
  "name": "@pm-os/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Pm.Os — agentic DevOps platform for AI-native software teams (headless web + CLI)",
  "author": "Bruna Goncalves Vasconcelos",
  "main": "src/server/headless.ts",
  "scripts": {
    "typecheck": "tsc -b --noEmit",
    "pretest": "node ../../scripts/rebuild-better-sqlite3.mjs ensure node",
    "test": "vitest run",
    "web:build": "vite build --config vite.web.config.ts",
    "preserver": "node ../../scripts/rebuild-better-sqlite3.mjs ensure node",
    "server": "tsx src/server/headless.ts",
    "cli": "tsx src/server/cli.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@pm-os/agent-orchestration": "workspace:*",
    "@pm-os/ai-sdk": "workspace:*",
    "@pm-os/boards": "workspace:*",
    "@pm-os/database": "workspace:*",
    "@pm-os/eval": "workspace:*",
    "@pm-os/integrations": "workspace:*",
    "@pm-os/memory": "workspace:*",
    "@pm-os/observability": "workspace:*",
    "@pm-os/reporting": "workspace:*",
    "@pm-os/shared": "workspace:*",
    "@pm-os/tool-registry": "workspace:*",
    "@fastify/cors": "^9.0.0",
    "@fastify/static": "^7.0.0",
    "better-sqlite3": "^12.10.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@tanstack/react-query": "^5.28.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^4.26.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.358.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.22.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/react": "^15.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tsx": "^4.7.0",
    "vite": "^5.2.0",
    "vitest": "^1.4.0"
  }
}
