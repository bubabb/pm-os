{
  "name": "pm-os",
  "version": "0.1.0",
  "private": true,
  "description": "Pm.Os — The agentic DevOps platform for AI-native software teams",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "web:build": "pnpm --filter @pm-os/desktop run web:build",
    "server": "PMOS_DEV_AUTH=1 pnpm --filter @pm-os/desktop run server",
    "cli": "pnpm --filter @pm-os/desktop run cli",
    "pm-os": "pnpm build:packages && pnpm web:build && pnpm server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "rebuild:sqlite:node": "node scripts/rebuild-better-sqlite3.mjs node",
    "check:auth": "node scripts/check-claude-cli-auth.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "memory:sync": "python3 scripts/memory-sync.py",
    "memory:check": "python3 scripts/memory-sync.py --check",
    "memory:recall": "python3 scripts/memory-recall.py",
    "memory:provision": "bash scripts/memory-provision.sh --project",
    "memory:status": "bash scripts/memory-provision.sh --status"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "vitest": "^1.4.0",
    "@vitest/coverage-v8": "^1.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
