{
  "name": "creare",
  "version": "0.1.0",
  "private": true,
  "description": "Creare — The agentic DevOps platform for AI-native software teams",
  "scripts": {
    "build": "turbo run build",
    "predev": "node scripts/rebuild-better-sqlite3.mjs ensure electron && node scripts/install-desktop-entry.mjs",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "rebuild:sqlite:node": "node scripts/rebuild-better-sqlite3.mjs node",
    "rebuild:sqlite:electron": "node scripts/rebuild-better-sqlite3.mjs electron",
    "check:auth": "node scripts/check-claude-cli-auth.mjs",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "vitest": "^1.4.0",
    "@vitest/coverage-v8": "^1.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
